# Backend — copy this file to .env for local development
TERRAFORGE_ENV=local
TERRAFORGE_API_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMMA_TIMEOUT_SECONDS=60
VEO_MODEL=veo-3.1-generate-preview
VEO_POLL_INTERVAL_SECONDS=10
VEO_TIMEOUT_SECONDS=600
LYRIA_MODEL=lyria-3-clip-preview
LYRIA_TIMEOUT_SECONDS=180
MAX_MEDIA_ATTEMPTS=3
GCP_PROJECT_ID=
GCP_REGION=us-central1
FIRESTORE_DATABASE=(default)
ARTIFACT_BUCKET=
PUBSUB_TOPIC=terraforge-run-events
WORKFLOW_TOPIC=terraforge-workflow-tasks
MEDIA_TOPIC=terraforge-media-tasks
ANALYSIS_JOB_NAME=terraforge-analysis-job
INTERNAL_INVOKER_EMAIL=
OTEL_EXPORTER_OTLP_ENDPOINT=
MONITORING_WEBHOOK_URL=

# Frontend: no provider API key is exposed to the browser
VITE_API_BASE_URL=http://localhost:8000
FIRMS_MAP_KEY=
SENTINEL_STAC_URL=https://earth-search.aws.element84.com/v1
SENTINEL_ANALYSIS_ENABLED=true

# ThermaSite / FortyGuard — backend only; sent in the api-key header
FORTYGUARD_API_KEY=
FORTYGUARD_BASE_URL=https://api.fortyguard.com
FORTYGUARD_REQUEST_TIMEOUT_SECONDS=60
FORTYGUARD_POLL_INTERVAL_SECONDS=5
FORTYGUARD_POLL_TIMEOUT_SECONDS=600
